            { "col": 5,  "colspan": 1, "enabled": true,  "id": "gcode_console",    "row": 1,  "rowspan": 1 },
            { "col": -1, "colspan": 2, "enabled": false, "id": "camera",           "row": -1, "rowspan": 2 },
            { "col": 5,  "colspan": 1, "enabled": true,  "id": "notifications",    "row": 3,  "rowspan": 1 },
